{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.json",
        "tsconfigOverride": {
          "compilerOptions": {
            "module": "commonjs",
            "moduleResolution": "node"
          }
        }
      }
    ]
  },
  "testEnvironment": "node"
}
