generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// The customers service owns only its own database. companyId is a logical
// reference into the auth service's Company table — no FK, no local Company
// table (wayfinder ticket 06: per-service DBs, logical refs across services).
model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @db.Uuid
  name      String
  email     String?
  phone     String?
  taxId     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}
