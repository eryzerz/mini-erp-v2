{
  "version": 2,
  "buildCommand": "pnpm --filter @repo/contracts build && pnpm --filter @repo/common build && next build",
  "rewrites": [
    {
      "source": "/api/v1/auth/:path*",
      "destination": "https://slm-api-auth.onrender.com/api/v1/auth/:path*"
    },
    {
      "source": "/api/v1/users/:path*",
      "destination": "https://slm-api-auth.onrender.com/api/v1/users/:path*"
    },
    {
      "source": "/api/v1/customers/:path*",
      "destination": "https://slm-api-customers.onrender.com/api/v1/customers/:path*"
    },
    {
      "source": "/api/v1/invoices/:path*",
      "destination": "https://slm-api-invoices.onrender.com/api/v1/invoices/:path*"
    },
    {
      "source": "/api/v1/dashboard/:path*",
      "destination": "https://slm-api-dashboard.onrender.com/api/v1/dashboard/:path*"
    },
    {
      "source": "/customers/:path*",
      "destination": "https://mini-erp-v2-zone-customers.vercel.app/customers/:path*"
    },
    {
      "source": "/invoices/:path*",
      "destination": "https://mini-erp-v2-zone-invoices.vercel.app/invoices/:path*"
    }
  ]
}
